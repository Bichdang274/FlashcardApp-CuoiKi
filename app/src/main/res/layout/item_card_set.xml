<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card_dark"
    android:layout_marginBottom="12dp">
    <LinearLayout android:id="@+id/headerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐾" android:textSize="36sp" android:layout_marginEnd="12dp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Animals" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvTitleVi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Động Vật" android:textColor="@color/text_secondary" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/tvCardCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 thẻ" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/tvProgressText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Đã thuộc: 0/10" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <TextView android:id="@+id/tvPct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <ProgressBar style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/progress_gradient" android:progress="0" android:max="100" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnStudy"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Học thẻ" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold"
                android:drawableStart="@drawable/ic_book" android:drawableTint="@color/white" android:drawablePadding="4dp"
                android:background="@drawable/bg_btn_gradient" android:stateListAnimator="@null"
                android:layout_marginEnd="5dp" android:paddingHorizontal="6dp"/>
            <Button android:id="@+id/btnQuiz"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Kiểm tra" android:textColor="@color/white" android:textSize="10sp"
                android:drawableStart="@drawable/ic_lightning" android:drawableTint="@color/white" android:drawablePadding="4dp"
                android:background="@drawable/bg_nav_btn" android:stateListAnimator="@null"
                android:layout_marginEnd="5dp" android:paddingHorizontal="6dp"/>
            <Button android:id="@+id/btnGame"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Nối từ" android:textColor="@color/white" android:textSize="10sp"
                android:drawableStart="@drawable/ic_game" android:drawableTint="@color/white" android:drawablePadding="4dp"
                android:background="@drawable/bg_nav_btn" android:stateListAnimator="@null"
                android:paddingHorizontal="6dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
