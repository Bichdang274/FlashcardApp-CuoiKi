<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" android:layout_marginBottom="4dp"
            android:background="#44FFFFFF"/>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="12dp">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Về ứng dụng"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_close"
                android:contentDescription="Đóng"/>
        </LinearLayout>

        <!-- App logo + name -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingTop="8dp" android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="80dp" android:layout_height="80dp"
                android:background="@drawable/bg_logo"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📖" android:textSize="36sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FlashCard English"
                android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="28dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Phiên bản 1.0.0"
                    android:textColor="#FFFFFF" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0DFFFFFF"
            android:padding="16dp"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp" android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="12dp">
                <![CDATA[<b><font color="#A78BFA">FlashCard English</font></b> là ứng dụng học từ vựng tiếng Anh được thiết kế dành riêng cho người dùng Việt Nam, giúp bạn ghi nhớ từ vựng một cách hiệu quả, vui vẻ và khoa học.]]>
            </TextView>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Với hơn 50 từ vựng chia thành 5 chủ đề thực dụng, cùng các phương pháp học tập đa dạng — từ flashcard 3D, quiz trắc nghiệm cho đến trò chơi nối từ — ứng dụng giúp bạn tiếp thu từ vựng tự nhiên như người bản ngữ."
                android:textColor="#BBBBCC" android:textSize="13sp" android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- TÍNH NĂNG NỔI BẬT -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TÍNH NĂNG NỔI BẬT"
            android:textColor="#8899AA" android:textSize="11sp" android:letterSpacing="0.1"
            android:layout_marginStart="20dp" android:layout_marginBottom="12dp"/>

        <!-- Features grid -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp">

            <!-- Row 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🃏" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Flashcard 3D"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thẻ lật với hiệu ứng 3D sống động"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🧠" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Spaced Repetition"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thuật toán SM-2 giúp nhớ lâu hơn"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔊" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Phát âm chuẩn"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Web Speech API hỗ trợ phát âm trực tiếp"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📝" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Quiz trắc nghiệm"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="4 đáp án với đếm ngược thời gian"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎯" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Trò chơi nối từ"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Học vui với confetti và hiệu ứng đẹp"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Theo dõi tiến độ"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Streak, thống kê và lịch sử học tập"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📁" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thư mục cá nhân"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tạo bộ từ vựng riêng theo nhu cầu"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_chip_inactive"
                    android:padding="12dp" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌙" android:textSize="22sp" android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Giao diện linh hoạt"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hỗ trợ chế độ sáng và tối"
                        android:textColor="#8899AA" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PHƯƠNG PHÁP HỌC -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_chip_inactive"
            android:padding="16dp"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚡" android:textSize="16sp" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Phương pháp học"
                    android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="📚" android:textSize="16sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Spaced Repetition (SM-2)"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Lặp lại ngắt quãng khoa học"
                        android:textColor="#8899AA" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="👁" android:textSize="16sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Active Recall"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tự nhớ lại thay vì đọc thụ động"
                        android:textColor="#8899AA" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="🎮" android:textSize="16sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Gamification"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Học qua trò chơi tăng động lực"
                        android:textColor="#8899AA" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="○" android:textColor="#8899AA" android:textSize="12sp"
                android:layout_marginEnd="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Dữ liệu được lưu trữ cục bộ trên thiết bị"
                android:textColor="#8899AA" android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Made with ❤️ for Vietnamese English learners"
            android:textColor="#8899AA" android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="20dp" android:paddingEnd="20dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
