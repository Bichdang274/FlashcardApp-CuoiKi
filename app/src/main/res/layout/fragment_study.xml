<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark">

    <!-- Study Content -->
    <LinearLayout
        android:id="@+id/studyContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_icon_btn"
                android:tint="@color/text_primary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="12dp">

                <TextView
                    android:id="@+id/tvSetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Học thẻ"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/10"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_shuffle"
                android:background="@drawable/bg_icon_btn"
                android:tint="@color/text_primary"/>
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="@drawable/progress_gradient"
            android:progress="10"
            android:max="100"
            android:layout_marginHorizontal="16dp"/>

        <!-- Session stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅ " android:textSize="12sp"/>
            <TextView android:id="@+id/tvKnownCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#66FF99" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  📖 " android:textSize="12sp"/>
            <TextView android:id="@+id/tvLearningCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFAA44" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- FRONT Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:id="@+id/cardFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_study"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐕"
                    android:textSize="64sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dog"
                    android:textColor="@color/text_primary"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/dɒɡ/"
                    android:textColor="#C084FC"
                    android:textSize="18sp"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhấn để lật thẻ"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp"/>

                <ImageButton
                    android:id="@+id/btnSpeak"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_volume"
                    android:background="@drawable/bg_icon_btn"
                    android:tint="#C084FC"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- BACK Card -->
            <LinearLayout
                android:id="@+id/cardBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_study_back"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVietnamese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chó"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/purple_300" android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The dog is playing in the garden."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:fontStyle="italic"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvExampleVi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Con chó đang chơi trong vườn."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Rate Buttons -->
        <LinearLayout
            android:id="@+id/layoutRateButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnLearning"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="❌  Chưa thuộc"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_wrong"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnKnow"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="✅  Đã thuộc"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_correct"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Navigation buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_chevron_left"
                android:background="@drawable/bg_nav_btn"
                android:tint="@color/text_primary"/>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_chevron_right"
                android:background="@drawable/bg_btn_gradient_circle"
                android:tint="@color/white"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Complete Screen -->
    <LinearLayout
        android:id="@+id/completeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView android:id="@+id/tvCompleteEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎉" android:textSize="72sp" android:layout_marginBottom="16dp"/>
        <TextView android:id="@+id/tvCompleteTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xuất sắc!" android:textColor="@color/text_primary" android:textSize="32sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvCompleteSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bạn đã hoàn thành!" android:textColor="@color/text_secondary" android:textSize="16sp" android:layout_marginBottom="32dp"/>
        <TextView android:id="@+id/tvStatsKnown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅ Thuộc: 0 thẻ" android:textColor="#66FF99" android:textSize="16sp" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvStatsLearning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📖 Đang học: 0 thẻ" android:textColor="#FFAA44" android:textSize="16sp" android:layout_marginBottom="40dp"/>

        <Button android:id="@+id/btnRestart" android:layout_width="match_parent" android:layout_height="56dp" android:text="🔄  Học lại" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp" android:background="@drawable/bg_btn_gradient" android:stateListAnimator="@null" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnHome" android:layout_width="match_parent" android:layout_height="56dp" android:text="Về trang chủ" android:textColor="@color/white" android:textStyle="bold" android:textSize="16sp" android:background="@drawable/bg_nav_btn" android:stateListAnimator="@null"/>
    </LinearLayout>

</FrameLayout>
