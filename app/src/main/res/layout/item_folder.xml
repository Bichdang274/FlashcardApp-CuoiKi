<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp"
    android:layout_marginEnd="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/tvEmoji" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📁" android:textSize="36sp"/>
        <ImageButton android:id="@+id/btnDelete"
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:background="@android:color/transparent"
            android:tint="@color/text_secondary"
            android:padding="0dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Folder" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
    <TextView android:id="@+id/tvWordCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 từ" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnStudy"
            android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
            android:text="" android:textColor="@color/white"
            android:drawableTop="@drawable/ic_book" android:drawableTint="@color/white"
            android:background="@drawable/bg_btn_gradient_small" android:stateListAnimator="@null"
            android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnQuiz"
            android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
            android:text="" android:textColor="@color/white"
            android:drawableTop="@drawable/ic_lightning" android:drawableTint="@color/white"
            android:background="@drawable/bg_nav_btn_small" android:stateListAnimator="@null"
            android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnGame"
            android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
            android:text="" android:textColor="@color/white"
            android:drawableTop="@drawable/ic_game" android:drawableTint="@color/white"
            android:background="@drawable/bg_nav_btn_small" android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
