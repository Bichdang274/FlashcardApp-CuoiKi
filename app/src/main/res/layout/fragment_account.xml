<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tài khoản"
            android:textColor="@color/text_primary"
            android:textSize="28sp" android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingTop="60dp" android:paddingBottom="16dp"/>

        <!-- Profile card -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/bg_avatar" android:gravity="center"
                    android:layout_marginEnd="14dp">
                    <TextView android:id="@+id/tvAvatar"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="U" android:textColor="@color/white"
                        android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Demo User"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvEmail"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="demo@test.com"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Badge -->
            <LinearLayout
                android:id="@+id/badgeActive"
                android:layout_width="wrap_content" android:layout_height="30dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center_vertical"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎓 Học viên tích cực"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- THỐNG KÊ HỌC TẬP -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="THỐNG KÊ HỌC TẬP"
                android:textColor="@color/text_secondary" android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <!-- Stats row 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <!-- Từ đã học -->
                <LinearLayout android:id="@+id/cardWordsLearned"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_teal" android:padding="14dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📚" android:textSize="20sp" android:layout_marginBottom="6dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/tvWordsLearned"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/text_primary"
                            android:textSize="22sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvWordsTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="/0" android:textColor="@color/text_secondary"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="2dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Từ đã học"
                            android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Thư mục -->
                <LinearLayout android:id="@+id/cardFolders"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_green" android:padding="14dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📁" android:textSize="20sp" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/tvSetsCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/text_primary"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="2dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thư mục"
                            android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Stats row 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Streak -->
                <LinearLayout android:id="@+id/cardStreak"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_orange" android:padding="14dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔥" android:textSize="20sp" android:layout_marginBottom="6dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/tvStreak"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/text_primary"
                            android:textSize="22sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" ngày" android:textColor="@color/text_secondary"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="2dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Streak"
                            android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Phiên học -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/bg_stat_yellow" android:padding="14dp"
                    android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐" android:textSize="20sp" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/tvSessions"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/text_primary"
                        android:textSize="22sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="2dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Phiên học"
                            android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        <ImageView android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Progress bar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiến độ tổng thể"
                    android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <TextView android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/progressTotal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp"
                android:progress="0"
                android:progressDrawable="@drawable/progress_gradient"
                android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/>
        </LinearLayout>

        <!-- CÀI ĐẶT section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp" android:paddingBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CÀI ĐẶT"
                android:textColor="@color/text_secondary" android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark">

                <!-- Thông báo -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="🔔" android:textSize="18sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thông báo"
                            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nhắc nhở học tập"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggleNotification"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Âm thanh -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="🔊" android:textSize="18sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Âm thanh"
                            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Phát âm &amp; hiệu ứng"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggleSound"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Chế độ tối -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="🌙" android:textSize="18sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Chế độ tối"
                            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvDarkModeSubtitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Đang bật chế độ sáng"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggleDark"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- TÀI KHOẢN section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp" android:paddingBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TÀI KHOẢN"
                android:textColor="@color/text_secondary" android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark">

                <!-- Thông tin cá nhân -->
                <LinearLayout android:id="@+id/btnProfile"
                    android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="👤" android:textSize="18sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thông tin cá nhân"
                            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Xem và chỉnh sửa hồ sơ"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_secondary"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#15000000"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                <!-- Về ứng dụng -->
                <LinearLayout android:id="@+id/btnAbout"
                    android:layout_width="match_parent" android:layout_height="64dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="36dp" android:layout_height="36dp"
                        android:text="ℹ️" android:textSize="18sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:paddingStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Về ứng dụng"
                            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Phiên bản 1.0.0"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Đăng xuất button -->
        <Button android:id="@+id/btnLogout"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="→  Đăng xuất"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
            android:background="@drawable/bg_btn_gradient"
            android:stateListAnimator="@null"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"/>

        <!-- Footer links -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp" android:paddingBottom="100dp">
            <TextView android:id="@+id/tvDeleteAccount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🗑 Xóa tài khoản"
                android:textColor="#EF4444" android:textSize="12sp"
                android:clickable="true" android:focusable="true"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Chính sách bảo mật"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
