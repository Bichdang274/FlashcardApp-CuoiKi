<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_gradient_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_gradient_dark" android:padding="20dp" android:paddingTop="52dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_arrow_back" android:background="@drawable/bg_icon_btn" android:tint="@color/text_primary"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/tvEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐾" android:textSize="48sp" android:layout_marginEnd="16dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Animals" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Động Vật" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                <TextView android:id="@+id/tvCardCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 thẻ" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnStudy"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Học thẻ" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold"
                android:drawableStart="@drawable/ic_book" android:drawableTint="@color/white" android:drawablePadding="4dp"
                android:background="@drawable/bg_btn_gradient" android:stateListAnimator="@null"
                android:layout_marginEnd="6dp" android:paddingHorizontal="8dp"/>
            <Button android:id="@+id/btnQuiz"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Kiểm tra" android:textColor="@color/white" android:textSize="12sp"
                android:drawableStart="@drawable/ic_lightning" android:drawableTint="@color/white" android:drawablePadding="4dp"
                android:background="@drawable/bg_nav_btn" android:stateListAnimator="@null"
                android:layout_marginHorizontal="6dp" android:paddingHorizontal="8dp"/>
            <Button android:id="@+id/btnGame"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Nối từ" android:textColor="@color/white" android:textSize="12sp"
                android:drawableStart="@drawable/ic_game" android:drawableTint="@color/white" android:drawablePadding="4dp"
                android:background="@drawable/bg_nav_btn" android:stateListAnimator="@null"
                android:paddingHorizontal="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCards" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:clipToPadding="false"/>
</LinearLayout>
